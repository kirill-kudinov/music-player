<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:player="clr-namespace:MusicPlayer.Features.Player"
             xmlns:components="clr-namespace:MusicPlayer.Features.Player.Components"
             x:Class="MusicPlayer.Features.Player.PlayerPage"
             x:DataType="player:PlayerViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="Transparent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="PlayerBackgroundGradientBrush"
                                 StartPoint="0.5,0"
                                 EndPoint="0.5,1">
                <GradientStop Color="{StaticResource BgGradientStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource BgGradientEnd}" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Нижний паддинг 86px для удобного расположения под палец -->
            <Thickness x:Key="PlayerScreenPadding">20,48,20,86</Thickness>
            <Thickness x:Key="TrackInfoBottomMargin">0,0,0,28</Thickness>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="PlayerRootGrid"
          RowDefinitions="Auto, *, Auto, Auto"
          Padding="{StaticResource PlayerScreenPadding}"
          Background="{StaticResource PlayerBackgroundGradientBrush}">

        <!-- 1. Верхняя панель -->
        <components:PlayerHeaderView x:Name="HeaderSection"
                                     Grid.Row="0">
            <components:PlayerHeaderView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnCollapsePanUpdated" />
            </components:PlayerHeaderView.GestureRecognizers>
        </components:PlayerHeaderView>

        <!-- 2. Обложка трека -->
        <components:TrackCoverView x:Name="CoverSection"
                                   Grid.Row="1"
                                   VerticalOptions="Center">
            <components:TrackCoverView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnCollapsePanUpdated" />
            </components:TrackCoverView.GestureRecognizers>
        </components:TrackCoverView>

        <!-- 3. Информация о треке и сердечко -->
        <components:TrackInfoView x:Name="TrackInfoSection"
                                  Grid.Row="2"
                                  Margin="{StaticResource TrackInfoBottomMargin}" />

        <!-- 4. Панель управления и слайдер -->
        <components:PlayerControlsView x:Name="ControlsSection"
                                       Grid.Row="3" />

    </Grid>
</ContentPage>