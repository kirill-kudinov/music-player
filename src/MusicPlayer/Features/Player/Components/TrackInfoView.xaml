<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:player="clr-namespace:MusicPlayer.Features.Player"
             x:Class="MusicPlayer.Features.Player.Components.TrackInfoView"
             x:DataType="player:PlayerViewModel"
             x:Name="RootView">

    <Grid RowDefinitions="Auto, Auto"
          ColumnDefinitions="*, 40"
          RowSpacing="4"
          VerticalOptions="Center">

        <!-- Название трека -->
        <Label Grid.Row="0"
               Grid.Column="0"
               Text="{Binding CurrentTrack.Title, FallbackValue='None'}"
               Style="{StaticResource TrackTitleLabelStyle}" />

        <!-- Исполнитель -->
        <Label Grid.Row="1"
               Grid.Column="0"
               Text="{Binding CurrentTrack.Artist, FallbackValue='None'}"
               Style="{StaticResource TrackArtistLabelStyle}" />

        <!-- Сердечко Избранное: переключение между player_heart_active.svg и player_heart_inactive.svg -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Style="{StaticResource PlayerIconButtonStyle}"
                HorizontalOptions="End"
                VerticalOptions="Center">
            <Border.Behaviors>
                <toolkit:TouchBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference RootView}, x:DataType=ContentView}"
                                       Command="{Binding ToggleFavoriteCommand}"
                                       DefaultAnimationDuration="150"
                                       DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                                       DefaultBackgroundColor="Transparent"
                                       HoveredBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedScale="0.88"
                                       PressedOpacity="0.75"
                                       ShouldMakeChildrenInputTransparent="True" />
            </Border.Behaviors>

            <Image Style="{StaticResource FavoriteIconImageStyle}">
                <Image.Triggers>
                    <DataTrigger TargetType="Image"
                                 Binding="{Binding IsCurrentTrackFavorite}"
                                 Value="True">
                        <Setter Property="Source" Value="player_heart_active.png" />
                    </DataTrigger>
                    <DataTrigger TargetType="Image"
                                 Binding="{Binding IsCurrentTrackFavorite}"
                                 Value="False">
                        <Setter Property="Source" Value="player_heart_inactive.png" />
                    </DataTrigger>
                </Image.Triggers>
            </Image>
        </Border>

    </Grid>
</ContentView>