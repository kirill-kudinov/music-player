<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:player="clr-namespace:MusicPlayer.Features.Player"
             x:Class="MusicPlayer.Features.Player.Components.PlayerHeaderView"
             x:DataType="player:PlayerViewModel"
             x:Name="RootView">

    <ContentView.Resources>
        <ResourceDictionary>
            <x:Double x:Key="HeaderTitleFontSize">12</x:Double>

            <Style x:Key="HeaderIconButtonStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeaderTitleLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Roboto-Bold" />
                <Setter Property="FontSize" Value="{StaticResource HeaderTitleFontSize}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid ColumnDefinitions="40, *, 40"
          HeightRequest="40"
          VerticalOptions="Center">

        <!-- Кнопка свернуть плеер (Chevron Down: d="M34 65L40 71L46 65") -->
        <Border Grid.Column="0"
                Style="{StaticResource HeaderIconButtonStyle}">
            <Border.Behaviors>
                <toolkit:TouchBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference RootView}, x:DataType=ContentView}"
                                       Command="{Binding CollapseCommand}"
                                       DefaultAnimationDuration="150"
                                       DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                                       DefaultBackgroundColor="Transparent"
                                       HoveredBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedScale="0.92"
                                       PressedOpacity="0.75"
                                       ShouldMakeChildrenInputTransparent="True" />
            </Border.Behaviors>
            <Path Data="M6,9 L12,15 L18,9"
                  Stroke="{StaticResource TextPrimary}"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  WidthRequest="24"
                  HeightRequest="24"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
        </Border>

        <!-- Заголовок контекста воспроизведения ("Плейлист «Избранное»") -->
        <Label Grid.Column="1"
               Text="{Binding PlayContextTitle}"
               Style="{StaticResource HeaderTitleLabelStyle}"
               Margin="8,0" />

        <!-- Кнопка очереди воспроизведения (Queue Icon: 3 линии + круг r=2.5) -->
        <Border Grid.Column="2"
                Style="{StaticResource HeaderIconButtonStyle}">
            <Border.Behaviors>
                <toolkit:TouchBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference RootView}, x:DataType=ContentView}"
                                       Command="{Binding OpenQueueCommand}"
                                       DefaultAnimationDuration="150"
                                       DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                                       DefaultBackgroundColor="Transparent"
                                       HoveredBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedBackgroundColor="{StaticResource TouchOverlayLight}"
                                       PressedScale="0.92"
                                       PressedOpacity="0.75"
                                       ShouldMakeChildrenInputTransparent="True" />
            </Border.Behaviors>
            <Grid WidthRequest="24"
                  HeightRequest="24"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M4,6 H20 M4,12 H16 M4,18 H11"
                      Stroke="{StaticResource TextPrimary}"
                      StrokeThickness="2"
                      StrokeLineCap="Round" />
                <Ellipse WidthRequest="5"
                         HeightRequest="5"
                         Fill="{StaticResource TextPrimary}"
                         Stroke="{StaticResource TextPrimary}"
                         StrokeThickness="2"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         Margin="15,15,0,0" />
            </Grid>
        </Border>

    </Grid>
</ContentView>