<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:player="clr-namespace:MusicPlayer.Features.Player"
             x:Class="MusicPlayer.Features.Player.Components.TrackCoverView"
             x:DataType="player:PlayerViewModel">

    <!-- Если TrackCover == null, отображается темная обложка-фолбэк #15151C с рамкой #1AFFFFFF -->
    <Border Style="{StaticResource PlayerCoverBorderStyle}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource Black}"
                    Offset="0,12"
                    Radius="24"
                    Opacity="0.35" />
        </Border.Shadow>

        <Image Source="{Binding TrackCover}"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />
    </Border>
</ContentView>