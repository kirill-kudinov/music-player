<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tracks="clr-namespace:MusicPlayer.Features.Tracks"
             x:Class="MusicPlayer.Features.Tracks.Components.TrackOptionsBottomSheet"
             x:DataType="tracks:TracksViewModel"
             x:Name="RootView"
             IsVisible="False"
             InputTransparent="True"
             ZIndex="20">

    <Grid>
        <!-- Полупрозрачный фон (Scrim) с закрытием по нажатию вне шторки -->
        <Grid x:Name="BackdropScrim"
              BackgroundColor="Transparent"
              Opacity="0"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseTrackOptionsCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Выдвигающийся снизу Bottom Sheet в стиле YouTube Music -->
        <Border x:Name="BottomSheetContainer"
                Style="{StaticResource BottomSheetContainerBorderStyle}"
                TranslationY="420">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="0">

                <!-- 1. Индикатор перетаскивания (Drag Handle Pill) в стиле YouTube Music -->
                <BoxView Style="{StaticResource BottomSheetDragHandleStyle}" />

                <!-- 2. Шапка Bottom Sheet с обложкой, названием и исполнителем трека -->
                <Grid ColumnDefinitions="48, *"
                      ColumnSpacing="14"
                      Padding="20,6,20,14"
                      InputTransparent="True">

                    <Border Grid.Column="0"
                            Style="{StaticResource MiniPlayerCoverBorderStyle}"
                            InputTransparent="True">
                        <Image Source="{Binding SelectedTrackForOptions.Cover}"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                    </Border>

                    <Grid Grid.Column="1"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="2"
                          VerticalOptions="Center"
                          InputTransparent="True">
                        <Label Grid.Row="0"
                               Text="{Binding SelectedTrackForOptions.Track.Title}"
                               Style="{StaticResource TrackItemTitleLabelStyle}" />

                        <Label Grid.Row="1"
                               Text="{Binding SelectedTrackForOptions.Subtitle}"
                               Style="{StaticResource TrackItemSubtitleLabelStyle}" />
                    </Grid>
                </Grid>

                <!-- Тонкий разделитель на всю ширину шторки -->
                <BoxView HeightRequest="1"
                         Color="{StaticResource PopupDividerColor}"
                         Margin="0,0,0,6" />

                <!-- 3. Пункты меню действий в стиле YouTube Music (Material UI 3 SVG) -->
                <VerticalStackLayout Spacing="2"
                                     Padding="8,0,8,8">

                    <!-- Кнопка «Добавить в очередь» (popup_queue_add.svg) -->
                    <Border x:Name="QueueActionRow"
                            Style="{StaticResource BottomSheetActionRowBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddToQueueTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="24, *"
                              ColumnSpacing="20"
                              VerticalOptions="Center"
                              InputTransparent="True">
                            <Image Grid.Column="0"
                                   Source="popup_queue_add.png"
                                   Style="{StaticResource PlayerStaticIconImageStyle}"
                                   InputTransparent="True" />

                            <Label Grid.Column="1"
                                   Text="Добавить в очередь"
                                   Style="{StaticResource TrackPopupActionLabelStyle}"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>

                    <!-- Кнопка «Добавить в плейлист» (popup_playlist_add.svg) -->
                    <Border x:Name="PlaylistActionRow"
                            Style="{StaticResource BottomSheetActionRowBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddToPlaylistTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="24, *"
                              ColumnSpacing="20"
                              VerticalOptions="Center"
                              InputTransparent="True">
                            <Image Grid.Column="0"
                                   Source="popup_playlist_add.png"
                                   Style="{StaticResource PlayerStaticIconImageStyle}"
                                   InputTransparent="True" />

                            <Label Grid.Column="1"
                                   Text="Добавить в плейлист"
                                   Style="{StaticResource TrackPopupActionLabelStyle}"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>

                    <!-- Разделитель перед удалением -->
                    <BoxView HeightRequest="1"
                             Color="{StaticResource PopupDividerColor}"
                             Margin="12,4,12,4" />

                    <!-- Кнопка «Удалить трек» (Material UI 3 SVG ведра: popup_delete.svg) -->
                    <Border x:Name="DeleteActionRow"
                            Style="{StaticResource BottomSheetActionRowBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteTrackTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="24, *"
                              ColumnSpacing="20"
                              VerticalOptions="Center"
                              InputTransparent="True">
                            <Image Grid.Column="0"
                                   Source="popup_delete.png"
                                   Style="{StaticResource PlayerStaticIconImageStyle}"
                                   InputTransparent="True" />

                            <Label Grid.Column="1"
                                   Text="Удалить трек"
                                   Style="{StaticResource TrackPopupDestructiveLabelStyle}"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>