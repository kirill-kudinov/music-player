<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:importer="clr-namespace:MusicPlayer.Features.Importer"
             x:Class="MusicPlayer.Features.Importer.ImportPage"
             x:DataType="importer:ImportViewModel"
             BackgroundColor="{StaticResource BgCanvas }">
    <ContentPage.Content>

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center">
            <VerticalStackLayout
                Padding="24"
                Spacing="16"
                VerticalOptions="End">

                <Border StrokeShape="RoundRectangle 24"
                        Stroke="{StaticResource Gray400}"
                        StrokeThickness="1"
                        BackgroundColor="#181920"
                        Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportTrackCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *"
                          ColumnSpacing="16"
                          VerticalOptions="Center">
 
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#262833"
                                StrokeThickness="0"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                            <Image Source="tab_tracks_inactive.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="Выбрать аудиофайл"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </Grid>
    </ContentPage.Content>
</ContentPage>